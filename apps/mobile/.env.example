# GitHub OAuth Configuration (mobile)
# Create a GitHub OAuth App at https://github.com/settings/applications/new with:
# - Authorization callback URL: scratch://auth/callback
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_mobile_github_client_id_here

# Where the authorization code is exchanged for a token. Point this at the
# deployed github-token Netlify function so the client secret stays on the
# server (set GITHUB_MOBILE_CLIENT_ID / GITHUB_MOBILE_CLIENT_SECRET there).
EXPO_PUBLIC_AUTH_EXCHANGE_URL=https://your-site.netlify.app/.netlify/functions/github-token

# LEGACY - leave unset once EXPO_PUBLIC_AUTH_EXCHANGE_URL is configured.
# EXPO_PUBLIC_ variables are bundled into the app binary, so a secret placed
# here can be extracted by anyone who downloads the app.
# EXPO_PUBLIC_GITHUB_CLIENT_SECRET=
